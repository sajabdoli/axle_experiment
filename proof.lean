import Mathlib

/-!
Theorem 1 of arXiv:1908.03173 (Abdoli et al.), with its assumptions made explicit.

Informal: "any limit point of the sequence generated by the penalty method is a
solution of the original constrained problem."

What the paper's proof actually establishes, once every unstated assumption is
written down as a hypothesis:

  * `hmin`  — every iterate has penalised cost ≤ f(x*).  This is Lemma 1's first
              inequality; the paper justifies it by "w_i^k minimises L", so we
              take exactly that as a hypothesis.
  * `hfeas` — the limit point is feasible.  This is the sentence "if v^k is a
              feasible point ..." in the proof, promoted to a hypothesis.
  * `hlim`  — the sequence converges to x̄ ("the limit point" in the statement).

Under those, x̄ is a solution: feasible, and no feasible point does better.
-/
theorem penalty_limit_optimal
    {X : Type*} [TopologicalSpace X]
    (f G : X → ℝ) (hf : Continuous f)
    (C : Set X)                                          -- feasible set
    (hG_nonneg : ∀ x, 0 ≤ G x)                           -- penalty ≥ 0
    (c : ℝ) (hc : 0 < c)                                 -- penalty coefficient
    (xstar : X) (hstar : xstar ∈ C)
    (hopt : ∀ x ∈ C, f xstar ≤ f x)                      -- x* optimal
    (xk : ℕ → X)
    (hmin : ∀ k, f (xk k) + c * G (xk k) ≤ f xstar)      -- Lemma 1, as a hypothesis
    (xbar : X) (hlim : Filter.Tendsto xk Filter.atTop (nhds xbar))
    (hfeas : xbar ∈ C) :                                 -- feasibility of the limit
    xbar ∈ C ∧ ∀ x ∈ C, f xbar ≤ f x := by
  -- Step 1: drop the penalty term, since c * G ≥ 0
  have hk : ∀ k, f (xk k) ≤ f xstar := by
    intro k
    have h1 : 0 ≤ c * G (xk k) := mul_nonneg hc.le (hG_nonneg _)
    linarith [hmin k]
  -- Step 2: f (xk k) → f xbar, because f is continuous
  have hf_lim : Filter.Tendsto (f ∘ xk) Filter.atTop (nhds (f xbar)) :=
    (hf.tendsto xbar).comp hlim
  -- Step 3: a limit of terms ≤ b is ≤ b
  have hbar : f xbar ≤ f xstar :=
    le_of_tendsto' hf_lim (fun k => hk k)
  -- Step 4: x* beats every feasible x, so x̄ does too
  exact ⟨hfeas, fun x hx => hbar.trans (hopt x hx)⟩
